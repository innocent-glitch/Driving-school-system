<!DOCTYPE html>
<html>
<head>
  <title>Schedule Lesson - Isaac's Driving School</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { active: 'lessons' }) %>
    <main class="main-panel">
      <%- include('../partials/topbar', { pageTitle: 'Schedule Lesson', user: user }) %>

      <section style="max-width: 450px;">
        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <form method="POST" action="/dashboard/admin/lessons/new">
          <label>Student</label>
          <select name="student_id" required>
            <option value="">-- Select Student --</option>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>

          <label>Instructor</label>
          <select name="instructor_id" required>
            <option value="">-- Select Instructor --</option>
            <% instructors.forEach(i => { %>
              <option value="<%= i.id %>"><%= i.name %></option>
            <% }) %>
          </select>

          <label>Date</label>
          <input type="date" name="date" required>

          <label>Time</label>
          <input type="time" name="time" required>

          <button type="submit" class="btn">Schedule Lesson</button>
        </form>
      </section>
    </main>
  </div>
</body>
</html>