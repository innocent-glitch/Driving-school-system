<!DOCTYPE html>
<html>
<head>
  <title>Lessons - Excel Institute</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { active: 'lessons' }) %>
    <main class="main-panel">
      <%- include('../partials/topbar', { pageTitle: 'Lessons', user: user }) %>

      <div class="quick-actions">
        <a href="/dashboard/admin/lessons/new" class="btn btn-orange">+ Schedule Lesson</a>
      </div>

      <section>
        <h3>All Lessons</h3>
        <table>
          <tr>
            <th>Student</th><th>Instructor</th><th>Date</th><th>Time</th><th>Status</th><th>Action</th>
          </tr>
          <% lessons.forEach(l => { %>
            <tr>
              <td><%= l.student_name %></td>
              <td><%= l.instructor_name %></td>
              <td><%= l.date %></td>
              <td><%= l.time %></td>
              <td><span class="status status-<%= l.status %>"><%= l.status %></span></td>
              <td>
                <% if (l.status === 'scheduled') { %>
                  <form method="POST" action="/dashboard/admin/lessons/<%= l.id %>/status" style="display:inline;">
                    <input type="hidden" name="status" value="completed">
                    <button type="submit">Mark Complete</button>
                  </form>
                  <form method="POST" action="/dashboard/admin/lessons/<%= l.id %>/status" style="display:inline;">
                    <input type="hidden" name="status" value="cancelled">
                    <button type="submit">Cancel</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (lessons.length === 0) { %>
            <tr><td colspan="6">No lessons yet.</td></tr>
          <% } %>
        </table>
      </section>
    </main>
  </div>
</body>
</html>