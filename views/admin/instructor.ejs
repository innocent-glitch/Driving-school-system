<!DOCTYPE html>
<html>
<head>
  <title>Instructors - Isaac's Driving School</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { active: 'instructors' }) %>
    <main class="main-panel">
      <%- include('../partials/topbar', { pageTitle: 'Instructors', user: user }) %>

      <div class="quick-actions">
        <a href="/dashboard/admin/instructors/new" class="btn btn-green">+ Add Instructor</a>
      </div>

      <section>
        <h3>All Instructors</h3>
        <table>
          <tr>
            <th>Name</th><th>Email</th><th>Phone</th><th>Specialty</th>
          </tr>
          <% instructors.forEach(i => { %>
            <tr>
              <td><%= i.name %></td>
              <td><%= i.email %></td>
              <td><%= i.phone %></td>
              <td><%= i.specialty %></td>
            </tr>
          <% }) %>
          <% if (instructors.length === 0) { %>
            <tr><td colspan="4">No instructors yet.</td></tr>
          <% } %>
        </table>
      </section>
    </main>
  </div>
</body>
</html>