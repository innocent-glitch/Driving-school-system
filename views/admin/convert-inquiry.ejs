<!DOCTYPE html>
<html>
<head>
  <title>Convert Inquiry - Isaac's Driving School</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { active: 'inquiries' }) %>
    <main class="main-panel">
      <%- include('../partials/topbar', { pageTitle: 'Convert Inquiry', user: user }) %>

      <section style="max-width: 450px;">
        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <form method="POST" action="/dashboard/admin/inquiries/<%= inquiry.id %>/convert">
          <label>Full Name</label>
          <input type="text" name="name" value="<%= inquiry.name %>" required>

          <label>Email</label>
          <input type="email" name="email" value="<%= inquiry.email %>" required>

          <label>Phone</label>
          <input type="text" name="phone" value="<%= inquiry.phone %>">

          <label>Set a Password for this Student</label>
          <input type="password" name="password" required>

          <button type="submit" class="btn">Create Student Account</button>
        </form>
      </section>
    </main>
  </div>
</body>
</html>