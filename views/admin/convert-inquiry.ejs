<!DOCTYPE html>
<html>
<head>
  <title>Convert Inquiry - Isaac's Driving School</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Isaac's Driving School</h1>
    <nav>
      <a href="/dashboard/admin">Dashboard</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>

  <main>
    <h2>Convert Inquiry to Student</h2>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <form method="POST" action="/dashboard/admin/inquiries/<%= inquiry.id %>/convert">
      <label>Full Name</label>
      <input type="text" name="name" value="<%= inquiry.name %>" required>

      <label>Email</label>
      <input type="email" name="email" value="<%= inquiry.email %>" required>

      <label>Phone</label>
      <input type="text" name="phone" value="<%= inquiry.phone %>">

      <label>Set a Password for this Student</label>
      <input type="password" name="password" required>

      <button type="submit">Create Student Account</button>
    </form>
  </main>
</body>
</html>