<!DOCTYPE html>
<html>
<head>
  <title><%= student.name %> - Excel Institute</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { active: 'students' }) %>
    <main class="main-panel">
      <%- include('../partials/topbar', { pageTitle: student.name, user: user }) %>

      <section>
  <h3>Student Info</h3>
  <p><strong>Email:</strong> <%= student.email %></p>
  <p><strong>Phone:</strong> <%= student.phone %></p>
</section>
<section>
  <h3>Driving Tests</h3>
  <div class="quick-actions">
    <a href="/dashboard/admin/students/<%= student.id %>/tests/new" class="btn btn-orange">+ Book Test</a>
  </div>
  <table>
    <tr>
      <th>Date</th><th>Location</th><th>Result</th><th>Notes</th><th>Action</th>
    </tr>
    <% tests.forEach(t => { %>
      <tr>
        <td><%= t.test_date %></td>
        <td><%= t.location %></td>
        <td><span class="status status-<%= t.result === 'passed' ? 'completed' : (t.result === 'failed' ? 'cancelled' : 'scheduled') %>"><%= t.result %></span></td>
        <td><%= t.notes %></td>
        <td>
          <% if (t.result === 'pending') { %>
            <form method="POST" action="/dashboard/admin/tests/<%= t.id %>/result" style="display:inline;">
              <input type="hidden" name="result" value="passed">
              <button type="submit">Mark Passed</button>
            </form>
            <form method="POST" action="/dashboard/admin/tests/<%= t.id %>/result" style="display:inline;">
              <input type="hidden" name="result" value="failed">
              <button type="submit">Mark Failed</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (tests.length === 0) { %>
      <tr><td colspan="5">No tests booked yet.</td></tr>
    <% } %>
  </table>
</section>
<section style="max-width: 450px;">
  <h3>License Progress</h3>
  <form method="POST" action="/dashboard/admin/students/<%= student.id %>/license">
    <label>License Stage</label>
    <select name="license_stage">
      <option value="Not Started" <%= student.license_stage === 'Not Started' ? 'selected' : '' %>>Not Started</option>
      <option value="Learner Permit" <%= student.license_stage === 'Learner Permit' ? 'selected' : '' %>>Learner Permit</option>
      <option value="Test Scheduled" <%= student.license_stage === 'Test Scheduled' ? 'selected' : '' %>>Test Scheduled</option>
      <option value="Licensed" <%= student.license_stage === 'Licensed' ? 'selected' : '' %>>Licensed</option>
    </select>

    <label>Permit Number</label>
    <input type="text" name="permit_number" value="<%= student.permit_number || '' %>">

    <label>License Number</label>
    <input type="text" name="license_number" value="<%= student.license_number || '' %>">

    <button type="submit" class="btn">Update License Info</button>
  </form>
</section>

      <section>
        <h3>Lesson History</h3>
        <table>
          <tr>
            <th>Instructor</th><th>Date</th><th>Time</th><th>Status</th>
          </tr>
          <% lessons.forEach(l => { %>
            <tr>
              <td><%= l.instructor_name %></td>
              <td><%= l.date %></td>
              <td><%= l.time %></td>
              <td><span class="status status-<%= l.status %>"><%= l.status %></span></td>
            </tr>
          <% }) %>
          <% if (lessons.length === 0) { %>
            <tr><td colspan="4">No lessons yet.</td></tr>
          <% } %>
        </table>
      </section>

      <section>
        <h3>Payment History</h3>
        <table>
          <tr>
            <th>Amount</th><th>Method</th><th>Notes</th><th>Date</th>
          </tr>
          <% payments.forEach(p => { %>
            <tr>
              <td><%= p.amount %></td>
              <td><%= p.method %></td>
              <td><%= p.notes %></td>
              <td><%= p.paid_at %></td>
            </tr>
          <% }) %>
          <% if (payments.length === 0) { %>
            <tr><td colspan="4">No payments yet.</td></tr>
          <% } %>
        </table>
      </section>
    </main>
  </div>
</body>
</html>