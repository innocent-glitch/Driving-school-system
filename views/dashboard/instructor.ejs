<!DOCTYPE html>
<html>
<head>
  <title>Instructor Dashboard - Excel Institute</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Excel Institute</h1>
    <nav>
      <a href="/dashboard/instructor">My Schedule</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>

  <main class="wide">
    <h2>Welcome, <%= user.name %></h2>

    <section>
      <h3>My Lessons</h3>
      <table>
        <tr>
          <th>Student</th><th>Date</th><th>Time</th><th>Status</th><th>Action</th>
        </tr>
        <% lessons.forEach(l => { %>
          <tr>
            <td><%= l.student_name %></td>
            <td><%= l.date %></td>
            <td><%= l.time %></td>
            <td><%= l.status %></td>
            <td>
              <% if (l.status === 'scheduled') { %>
                <form method="POST" action="/dashboard/instructor/lessons/<%= l.id %>/complete">
                  <button type="submit">Mark Complete</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (lessons.length === 0) { %>
          <tr><td colspan="5">No lessons scheduled yet.</td></tr>
        <% } %>
      </table>
    </section>
  </main>
</body>
</html>
